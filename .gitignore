# Terraform
.terraform/
# Lock file is committed so CI and applies share the same AWS 5.x provider.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Node
node_modules/
npm-debug.log*
app/RUNTIME.txt

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Measurement output — never commit raw runs
results/raw/**
!results/raw/.gitkeep

# Agent scratch (not part of the program)
agent-tools/
