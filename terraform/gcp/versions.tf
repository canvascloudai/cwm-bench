terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region

  # Empty means Application Default Credentials. The JSON itself is never
  # committed; callers pass it as a variable at plan time.
  credentials = var.credentials_json != "" ? var.credentials_json : null
}
