#!/bin/bash
set -euo pipefail
umask 077
exec >/var/log/cwm-bootstrap.log 2>&1
dnf install -y git tar gzip python3
curl -fsSL https://github.com/grafana/k6/releases/download/v0.54.0/k6-v0.54.0-linux-amd64.tar.gz -o /tmp/k6.tgz
tar -xzf /tmp/k6.tgz -C /tmp
install -m 0755 /tmp/k6-v0.54.0-linux-amd64/k6 /usr/local/bin/k6
k6 version | grep -F 'k6 v0.54.0 '
git clone https://github.com/canvascloudai/cwm-bench.git /opt/cwm-source
git -C /opt/cwm-source checkout --detach '${measurement_sha}'
test "$(git -C /opt/cwm-source rev-parse HEAD)" = '${measurement_sha}'
install -d -m 0700 /opt/cwm-bench/results/raw
