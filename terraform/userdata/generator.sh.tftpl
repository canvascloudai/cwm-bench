#!/bin/bash
set -euo pipefail

# cwm-bench load generator. Installs a pinned k6 and copies load scripts.
# Why this instance exists: drive the four RPS rungs and the three 1000 RPS
# diagnostics without the generator being the bottleneck.

exec > /var/log/cwm-bench-generator-userdata.log 2>&1

dnf -y update
dnf -y install git tar gzip python3

# k6_version is interpolated by terraform. After that, bash uses $K6_VERSION
# without braces so terraform does not look for another template key.
K6_VERSION="${k6_version}"
K6_TARBALL="k6-$K6_VERSION-linux-amd64.tar.gz"
curl -fsSL -o /tmp/k6.tgz \
  "https://github.com/grafana/k6/releases/download/$K6_VERSION/$K6_TARBALL"
tar -C /tmp -xzf /tmp/k6.tgz
install -m 0755 /tmp/k6-$K6_VERSION-linux-amd64/k6 /usr/local/bin/k6
k6 version

install -d -m 0755 /opt/cwm-bench/load/lib /opt/cwm-bench/results

python3 - <<'PY'
import base64, pathlib
files = {
    "/opt/cwm-bench/load/scenarios.js": """${scenarios_js_b64}""",
    "/opt/cwm-bench/load/diagnostics.js": """${diagnostics_js_b64}""",
    "/opt/cwm-bench/load/lib/common.js": """${common_js_b64}""",
}
for path, b64 in files.items():
    pathlib.Path(path).write_bytes(base64.b64decode(b64))
PY

GIT_REF="${git_ref}"
GIT_URL="${git_url}"
if [ -n "$GIT_REF" ] && [ -n "$GIT_URL" ]; then
  rm -rf /opt/cwm-bench-src
  git clone --depth 1 --branch "$GIT_REF" "$GIT_URL" /opt/cwm-bench-src || \
    git clone --depth 1 "$GIT_URL" /opt/cwm-bench-src
  if [ -d /opt/cwm-bench-src/load ]; then
    cp -a /opt/cwm-bench-src/load/. /opt/cwm-bench/load/
  fi
fi

cat > /opt/cwm-bench/TARGET.env <<EOF
# Generated by terraform user_data. Default measurement protocol is HTTP:80.
export TARGET="http://${alb_dns}"
export TEST_ID="${test_id}"
export K6_VERSION="${k6_version}"
EOF

cat > /etc/profile.d/cwm-bench.sh <<'EOF'
# shellcheck disable=SC1091
[ -f /opt/cwm-bench/TARGET.env ] && . /opt/cwm-bench/TARGET.env
export PATH="/usr/local/bin:$PATH"
EOF

chown -R root:root /opt/cwm-bench
echo "generator ready; TARGET=http://${alb_dns}"
