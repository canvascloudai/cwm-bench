                "commands": [
                    "set -euo pipefail\n# cwm-bench adapter remote launch. Do not print secrets.\n# ADAPTER_K6_START\nif [ -f /opt/cwm-bench/TARGET.env ]; then . /opt/cwm-bench/TARGET.env; fi\ncd /opt/cwm-bench\nexport CAMPAIGN_ID='typical-later-day-20261006'\nexport RUN_ID='typical-later-day-2026-10-06T022913480Z'\nexport SPLIT='holdout'\nexport WARMUP='5m'\nexport DURATION='15m'\nexport RESULTS_DIR='/opt/cwm-bench/results/raw/typical-later-day-20261006/typical-later-day-2026-10-06T022913480Z'\nexport SCENARIO='typical-later-day'\nmkdir -p \"$RESULTS_DIR\"\nrm -f \"$RESULTS_DIR/exit.code\" \"$RESULTS_DIR/completed_at\" \"$RESULTS_DIR/pid\" \"$RESULTS_DIR/started_at\" \"$RESULTS_DIR/runner.log\"\nprintf '%s\\n' '{\"campaignId\":\"typical-later-day-20261006\",\"runId\":\"typical-later-day-2026-10-06T022913480Z\",\"scenario\":\"typical-later-day\"}' > \"$RESULTS_DIR/identity.json\"\ndate -u +%Y-%m-%dT%H:%M:%SZ > \"$RESULTS_DIR/started_at\"\nnohup setsid sh -c 'set +e\nk6 run --out json=\"$RESULTS_DIR/k6.json\" load/typical.js\nK6_EXIT=$?\nprintf \"%s\\n\" \"$K6_EXIT\" > \"$RESULTS_DIR/exit.code\"\ndate -u +%Y-%m-%dT%H:%M:%SZ > \"$RESULTS_DIR/completed_at\"\nexit \"$K6_EXIT\"' > \"$RESULTS_DIR/runner.log\" 2>&1 < /dev/null &\nK6_PID=$!\nprintf \"%s\\n\" \"$K6_PID\" > \"$RESULTS_DIR/pid\"\nprintf \"ADAPTER_K6_STARTED pid=%s\\n\" \"$K6_PID\"\nprintf \"results_dir=%s\\n\" \"$RESULTS_DIR\""
                ]
            },
